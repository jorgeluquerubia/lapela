# Supabase público: estas dos variables se incluyen en el cliente.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase privado: solo puede existir en el servidor o en el entorno de hosting.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Beta segura: mantener en simulated hasta aprobar y completar la spec de pagos reales.
LAPELA_PAYMENTS_MODE=simulated
APP_URL=http://localhost:3000

# Stripe es opcional en modo simulado.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LAPELA_LIVE_PAYMENTS=false
